{
  "mcpServers": {
    "qaeverest": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@qaeverestsupport.ai/qaeverest-mcp@^2"],
      "env": {
        "QAEVEREST_CLIENT": "cursor-plugin",
        "QAEVEREST_API_KEY": "${QAEVEREST_API_KEY}",
        "QAEVEREST_API_URL": "${QAEVEREST_API_URL}",
        "QAEVEREST_WORKSPACE": "${workspaceFolder}"
      }
    }
  }
}
